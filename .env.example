# Copy to .env and fill in what you need. `.env` is gitignored.
#
# Nothing here is required to build the workspace or to run the test
# suites: every variable gates an optional capability, and a capability
# with no credential reports as unavailable rather than failing.
#
# Precedence: the process environment always wins over this file, so CI -
# which sets variables properly - is never overridden by a developer's
# local copy. The first `.env` found beside the application under test is
# used, then the one beside the caller.
#
# Secrets are referenced by variable NAME in config files, never by
# value. Writing a literal credential into ai.yaml or a mappings file is
# a parse error, not a warning.


# ---------------------------------------------------------------------
# Figma  -  `testsmith figma pull`, and the figma dimension of a run
# ---------------------------------------------------------------------

# A Figma personal access token. Read by `figma pull`, and by any screen
# whose mappings declare `figmaSource: { token: env:FIGMA_TOKEN }`. A
# mapping may name a different variable; this is the default.
# Without it, `figma pull` stops and the figma dimension reports
# unavailable rather than skipping silently.
FIGMA_TOKEN=

# The Figma file and frame to pull from. Read from the process environment
# only - NOT from this file - because their sole consumer is the live-API
# test in integrations/flutter_testsmith_figma, which skips without them.
# FIGMA_SECOND_NODE_ID is optional:
#     FIGMA_TOKEN=... FIGMA_FILE_KEY=... FIGMA_NODE_ID=... dart test -t network
FIGMA_FILE_KEY=
FIGMA_NODE_ID=
FIGMA_SECOND_NODE_ID=


# ---------------------------------------------------------------------
# AI analysis  -  `testsmith run --ai`, `testsmith generate`
# ---------------------------------------------------------------------

# The key for whichever provider ai.yaml names. ai.yaml carries the
# variable's NAME under `apiKeyEnv`, never the key itself; the default
# per provider is below. Set the one that matches your provider.
#
# A missing key is never a test failure - the run reports the analysis as
# unavailable and leaves the deterministic verdict untouched.
GROQ_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
# OLLAMA_API_KEY=
# LLM_API_KEY=          # provider: custom


# ---------------------------------------------------------------------
# Authentication fixtures  -  `testsmith auth setup`
# ---------------------------------------------------------------------

# An auth file names its credentials as `env:NAME`, so the names depend
# on the file. These two are what examples/ecommerce_app/auth/demo.yaml
# asks for. The example's fixture backend accepts anything, so any
# non-empty value works.
MYTEST_DEMO_EMAIL=
MYTEST_DEMO_PASSWORD=


# ---------------------------------------------------------------------
# Tool discovery  -  process environment only, NOT read from this file
# ---------------------------------------------------------------------
#
# Listed here so the names are discoverable. Set them in your shell or CI
# configuration; the CLI reads them from the process environment.
#
#   MYTEST_ADB          an adb executable, named outright. Highest
#                       precedence.
#   ANDROID_HOME        $ANDROID_HOME/platform-tools/adb
#   ANDROID_SDK_ROOT    the same, consulted after ANDROID_HOME because
#                       Google deprecated it
#   PATH                adb, and `flutter` - which has no override at
#                       all. PATH is the only source for Flutter, by
#                       decision; FLUTTER_ROOT and FVM are deliberately
#                       not consulted.
#
# Build-time switches are --dart-define flags, not environment variables:
# TEST_MODE arms the SDK, and the SEED_* flags inject the seeded defects
# the example application is measured against.
