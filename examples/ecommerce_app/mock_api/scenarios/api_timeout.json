{
  "name": "api_timeout",
  "description": "the server answers after 9s, past the client's 5s timeout - no response at all, which is not a 500",
  "inherits": "default",
  "routes": {
    "GET /products/123": {
      "status": 200,
      "delayMs": 9000,
      "body": {
        "id": "123",
        "name": "Nonveg-Burger",
        "price": 90,
        "discount": 0,
        "available": true,
        "image": "https://example.com/nonveg-burger.png",
        "rating": 4.5
      }
    }
  }
}
