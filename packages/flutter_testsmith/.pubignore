# Kept in the repository, left out of the published archive.
#
# .gitignore at the repository root still applies; this file only adds.

# This test reads the Figma component's fixture (test/figma/fixtures/,
# excluded below), so it cannot run from a published archive. It runs
# from the repository only.
test/sdk/figma_defect_matrix_test.dart

# test/engine/fixtures/external/ holds UI trees captured from an external
# application on a device, with its text replaced by synthetic values.
# The published package does not need them; the two tests listed below
# read them. (Moved here with the engine, ADR-0011.)
test/engine/fixtures/external/
test/engine/external_app_tree_test.dart
test/engine/ui_property_resolution_test.dart

# The Figma fixtures keep the geometry, typography and structure of a real
# Figma frame; identifying names and text, node ids and keys are
# synthetic. The published package does not need them, and the tests
# listed below read them and cannot run without them. (Moved here with
# the Figma component, ADR-0011.)
test/figma/fixtures/
test/figma/layout_semantics_test.dart
test/figma/login_normalisation_test.dart
test/figma/normaliser_test.dart
test/figma/token_redaction_test.dart
